# Normalize line endings across Windows, macOS, and Linux.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets: Git should not attempt to merge them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.aseprite binary
*.zip binary
*.wav binary
*.mp3 binary
*.ogg binary
